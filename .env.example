# ============================================================================
# HOMESERVE – MASTER ENVIRONMENT VARIABLES (VERCEL / RENDER / MYSQL 8.0)
# Repository: https://github.com/Brijesh1990/home-serve-app.git
# ============================================================================

# --- FRONTEND (VITE / VERCEL) ---
VITE_APP_NAME="HomeServe"
VITE_APP_TAGLINE="Your Home, Our Responsibility."
# For unified Vercel deployment, use /api/v1. For separate backend deployment, set your backend URL:
VITE_API_BASE_URL="/api/v1"
VITE_RAZORPAY_KEY_ID="rzp_test_HomeServeKey123"
VITE_CLOUDINARY_CLOUD_NAME="demo-homeserve"
VITE_CLOUDINARY_UPLOAD_PRESET="homeserve_unsigned"
VITE_ENABLE_ANALYTICS="true"

# --- BACKEND (FASTAPI / VERCEL SERVERLESS / RENDER) ---
APP_NAME="HomeServe API"
ENVIRONMENT="production"
# Replace with your Managed Cloud MySQL 8.0 URI (Aiven / TiDB / Railway / PlanetScale):
# If left as localhost on Vercel, the backend automatically initializes its self-healing serverless database!
DATABASE_URL="mysql+pymysql://root:admin@localhost:3306/homeserve_db"
SECRET_KEY="homeserve-enterprise-super-secret-jwt-key-2026-production-ready"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# --- THIRD-PARTY INTEGRATIONS ---
RAZORPAY_KEY_ID="rzp_test_HomeServeKey123"
RAZORPAY_KEY_SECRET="rzp_test_HomeServeSecret456"
RAZORPAY_WEBHOOK_SECRET="whsec_HomeServeWebhook789"
CLOUDINARY_CLOUD_NAME="demo-homeserve"
CLOUDINARY_API_KEY="1234567890"
CLOUDINARY_API_SECRET="cloudinary_secret_demo"

# --- PLATFORM BUSINESS CONFIG ---
PLATFORM_COMMISSION_PERCENT="15.0"
TAX_PERCENT="18.0"
CORS_ORIGINS="https://home-serve-app.vercel.app,http://localhost:5173,http://localhost:3000"
